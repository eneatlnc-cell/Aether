# Aether Foundation 环境变量模板
# 复制为 .env.local 并填入实际值
#
# v3.6（单链 BSC）：唯一目标主网为 BNB Smart Chain（chainId 56）。
# 所有 NEXT_PUBLIC_* 地址变量均支持链专属后缀覆盖（_56 / _97）。

# === 链配置 ===
NEXT_PUBLIC_CHAIN_ID=56
# 56=BNB Smart Chain 主网（唯一目标链）, 97=BSC 测试网, 31337=Anvil 本地

# === 钱包连接 ===
NEXT_PUBLIC_WC_PROJECT_ID=
# 在 https://cloud.walletconnect.com 申请

# === 合约地址（部署后填入） ===
NEXT_PUBLIC_AETHER_RING_ADDRESS=
NEXT_PUBLIC_AETHER_GOVERNANCE_ADDRESS=
NEXT_PUBLIC_AETHER_ELECTION_ADDRESS=
# AetherDonation 合约地址（donateAndMint 入口）
NEXT_PUBLIC_AETHER_DONATION_ADDRESS=

# === 金库地址（必须显式配置，fail-safe） ===
# 预启动阶段：临时 EOA 接收稳定币捐款
# 正式启动后：切换为 Safe 多签地址
# 注意：无代码内置默认金库，未配置时捐款入口自动禁用
NEXT_PUBLIC_TREASURY_ADDRESS=

# === 捐款稳定币 ===
# 不配置时：BSC 主网默认用 Binance-Peg USDC（18 decimals）
# 换币示例（如改用 Binance-Peg USDT）：
# NEXT_PUBLIC_STABLECOIN_ADDRESS=0x55d398326f99059fF775485246999027B3197955
# NEXT_PUBLIC_STABLECOIN_SYMBOL=USDT
# 链专属覆盖：NEXT_PUBLIC_STABLECOIN_56_ADDRESS=0x...
# 自定义代币需同时配置精度：NEXT_PUBLIC_STABLECOIN_DECIMALS=18

# === Safe 多签地址 ===
NEXT_PUBLIC_SAFE_WALLET_ADDRESS=

# === IPFS 网关 ===
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# === 多链部署时可用链专属变量覆盖（可选） ===
# NEXT_PUBLIC_AETHER_RING_ADDRESS_56=0x...
# NEXT_PUBLIC_AETHER_GOVERNANCE_ADDRESS_56=0x...
# NEXT_PUBLIC_AETHER_ELECTION_ADDRESS_56=0x...
# NEXT_PUBLIC_SAFE_WALLET_ADDRESS_56=0x...
# NEXT_PUBLIC_TREASURY_ADDRESS_56=0x...

# === 服务端密钥（如使用 Serverless Function 中转 IPFS 上传） ===
# PINATA_API_KEY=
# PINATA_API_SECRET=

# === 服务端捐款验证 RPC（可选，默认用 BSC 公共 RPC） ===
# BSC_RPC_URL=https://bsc-dataseed.binance.org
# BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# === 部署密钥（仅本地 forge script 用，永不入仓） ===
# PRIVATE_KEY=
# BSC_RPC_URL=
# BSCSCAN_API_KEY=
