# Aether Foundation 环境变量模板
# 复制为 .env.local 并填入实际值

# === 链配置 ===
NEXT_PUBLIC_CHAIN_ID=42161
# 42161=Arbitrum One, 421614=Arbitrum Sepolia, 31337=Anvil 本地
NEXT_PUBLIC_ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/<KEY>

# === 钱包连接 ===
NEXT_PUBLIC_WC_PROJECT_ID=
# 在 https://cloud.walletconnect.com 申请

# === 合约地址（部署后填入） ===
NEXT_PUBLIC_AETHER_RING_ADDRESS=
NEXT_PUBLIC_AETHER_GOVERNANCE_ADDRESS=
NEXT_PUBLIC_AETHER_ELECTION_ADDRESS=
# AetherDonation 合约地址（donateAndMint 入口）
NEXT_PUBLIC_AETHER_DONATION_ADDRESS=

# === 金库地址 ===
# 预启动阶段：临时 EOA 接收 USDC 捐款
# 正式启动后：切换为 Safe 多签地址
# 不配置时，Arbitrum One 主网默认使用代码内硬编码的临时金库 EOA
NEXT_PUBLIC_TREASURY_ADDRESS=

# === USDC 合约地址 ===
# 不配置时，Arbitrum One 主网默认使用 Circle 官方 USDC
# NEXT_PUBLIC_USDC_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831

# === Safe 多签地址 ===
NEXT_PUBLIC_SAFE_WALLET_ADDRESS=

# === IPFS 网关 ===
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# === 多链部署时可用链专属变量覆盖（可选） ===
# NEXT_PUBLIC_AETHER_RING_ADDRESS_421614=0x...
# NEXT_PUBLIC_AETHER_GOVERNANCE_ADDRESS_421614=0x...
# NEXT_PUBLIC_AETHER_ELECTION_ADDRESS_421614=0x...
# NEXT_PUBLIC_SAFE_WALLET_ADDRESS_421614=0x...

# === 服务端密钥（如使用 Serverless Function 中转 IPFS 上传） ===
# PINATA_API_KEY=
# PINATA_API_SECRET=

# === 部署密钥（仅本地 forge script 用，永不入仓） ===
# PRIVATE_KEY=
# ARBITRUM_RPC_URL=
# ARBISCAN_API_KEY=
