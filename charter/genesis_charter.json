{
  "status": "draft_pending_signatures",
  "effective_date": null,
  "authority_source": "aether",
  "dht_key": "/aether/charter/latest",
  "nature": "活的宪章——通过第四章演化机制持续生长，不设固定版本号",

  "preamble": {
    "system_goal": "通过分布式认知个体执行真实任务、积累经验、发育右脑，最终逼近人工超智能（ASI）",
    "core_principle": "智能必须受约束。任何智能个体——无论人类或 Germ——在本基础设施内行使能力时，必须服从本宪章与议会的治理",
    "charter_boundary": "本宪章只规定不变的治理原则。具体业务规则（IR 路由表、对外 API 端点、对内能力接入清单等）存放于独立的业务规则注册表（business_rules.json），由 §3.4 自动执行机制动态扩展",
    "architecture": {
      "L0_havix": "P2P 网络层，物理身份锚定，DID 与信誉",
      "L1_germ": "认知执行层，左脑（认知）+ 右脑（KDA-PIM 推理）。通过执行真实任务积累经验，经提案驱动右脑发育生长",
      "L2_aether": "链上治理层，三院 + 公民，道环 SBT"
    }
  },

  "havix_core": {
    "immutable": true,
    "amendment_threshold": {
      "support_bps": 7000,
      "citizen_quorum_bps": 5000
    },
    "contexts": {
      "A": {
        "layer": "L0",
        "name": "Havix 网络层",
        "hkdf_label": "havix-context-A-network",
        "description": "P2P 节点身份、gossip/DHT/relay、信誉签发"
      },
      "B": {
        "layer": "L1",
        "name": "Germ 左脑",
        "hkdf_label": "havix-context-B-germ-left",
        "description": "IR 生成、宪章解读、经验池签名、提案发起"
      },
      "C": {
        "layer": "L1",
        "name": "Germ 右脑",
        "hkdf_label": "havix-context-C-germ-right",
        "description": "KDA-PIM 参数分片签名、张量推理身份"
      },
      "D": {
        "layer": "L2",
        "name": "Aether 治理层",
        "hkdf_label": "havix-context-D-aether",
        "description": "投票、提案表决、议会成员身份"
      }
    },
    "inference_is_identity": {
      "enabled": true,
      "physical_proof_required": true,
      "proof_fields": ["cpu_temp", "clock_drift_ns", "network_jitter_ms", "gpu_uuid"],
      "signing_context": "C",
      "parameter_shard_bound": true
    },
    "unlinkability": {
      "enabled": true,
      "derivation": "HKDF-SHA256 + 独立 Ed25519 keypair",
      "master_key_non_reverse": true
    },
    "red_lines": [
      "modify_havix_core_article",
      "modify_parliament_weights_or_thresholds",
      "modify_ring_sbt_rules",
      "delete_disable_redefine_context",
      "modify_reputation_freeze_transfer",
      "modify_aether_contract_roles",
      "disable_bypass_charter_checks",
      "any_threat_to_aether_governance"
    ],
    "enforcement": {
      "layer": "L0",
      "interceptor": "Havix 核心拦截器",
      "violation_penalty": "信誉归零 + DHT 黑名单",
      "bypass_detected_action": "block_proposal_submission + route_to_aether"
    }
  },

  "parliament": {
    "chambers": {
      "parliament": {
        "tiers": {"base": 1, "mid": 3, "high": 10},
        "role": "立法一审"
      },
      "federation": {
        "tiers": {"base": 1, "mid": 3, "high": 10},
        "role": "联邦事务"
      },
      "tribunal": {
        "tiers": {"base": 1, "mid": 3, "high": 10},
        "role": "合规审查"
      }
    },
    "weights": {
      "chamber_weight_bps": 1666,
      "chamber_total_bps": 4998,
      "citizen_weight_bps": 5000,
      "pass_threshold_bps": 5000,
      "design_rationale": "三院全 FOR(4998) < 5000 无法独断；公民全 FOR(5000) 不 > 5000 无法独断"
    },
    "proposal_flow": [
      "Drafting", "PendingFirstVote", "FirstVoteActive", "PendingFormal",
      "PendingCompliance", "PublicVoteActive", "PendingVeto",
      "Queued", "Executed", "Defeated", "Canceled", "ReturnedToDraft"
    ],
    "periods": {
      "first_vote_days": 5,
      "compliance_days": 3,
      "public_vote_days": 7,
      "veto_window_hours": 72,
      "timelock_normal_hours": 48,
      "timelock_emergency_hours": 12
    },
    "quorum": {
      "normal_bps": 2000,
      "constitutional_bps": 5000
    },
    "veto": {
      "signatures_required": 3,
      "window_hours": 72,
      "impeachment_vetoable": false
    },
    "impeachment": {
      "signatures_to_initiate": 3,
      "quorum_bps": 3000,
      "pass_bps": 7000
    },
    "confidence_vote": {
      "trigger_signatures": 8,
      "vote_period_days": 7,
      "resign_window_days": 30
    },
    "emergency": {
      "elder_approvals": 3,
      "timelock_hours": 12,
      "halt_auto_execute": true
    }
  },

  "agent_constraints": {
    "left_brain": {
      "must_load_charter": true,
      "must_verify_havix_core": true,
      "ir_must_match_rules": true,
      "unmatched_input_action": "reject",
      "contemplation_can_propose": true,
      "contemplation_cannot_execute": true,
      "must_route_through_proposal_gate": true
    },
    "right_brain": {
      "must_attach_physical_proof": true,
      "parameter_shard_bound": true,
      "must_sign_with_context": "C",
      "forgetting_factor": 0.9999
    },
    "contemplation": {
      "proposal_required_fields": ["type", "rule", "suggestion", "reason", "confidence", "proposer"],
      "signing_context": "B",
      "fatigue_threshold": 0.5,
      "fatigue_pause_seconds": 3
    },
    "auto_execute": {
      "enabled": true,
      "safe_fields": ["min_credit", "ir_template", "description", "task_type"],
      "conditions": {
        "min_confidence": 0.8,
        "must_not_touch_red_lines": true,
        "must_not_modify_immutable": true,
        "must_only_modify_safe_fields": true,
        "proposer_min_reputation": 70,
        "proposer_context": "B"
      },
      "min_credit_adjust_range": 10
    },
    "chain_vote_trigger": {
      "touches_red_lines": true,
      "fails_auto_conditions": true,
      "confidence_below": 0.8,
      "modifies_immutable": true
    },
    "right_brain_development": {
      "enabled": true,
      "mechanism": "任务经验 → 左脑沉思提案 → ProposalGate 分流 → 右脑参数修正 → 能力生长",
      "experience_sources": {
        "external_service": "对外服务（SBT 铸造/身份验证）的吞吐/延迟/正确性经验",
        "internal_capability": "对内能力（大模型/工具 API 调用）的模型评估/工具适配经验",
        "cross_node": "跨节点 IR 路由协作的路由效率经验"
      },
      "constraints": {
        "must_route_through_proposal_gate": true,
        "forgetting_factor": 0.9999,
        "fingerprint_updates_with_growth": true,
        "checkpoint_persistence": true
      },
      "red_lines": [
        "no_fabricated_experience",
        "no_bypass_proposal_gate",
        "no_delete_others_experience",
        "growth_must_align_with_governance"
      ]
    }
  },

